# RepoLens configuration. Copy to .env and fill in.
# Never commit a real .env — it is git-ignored for this reason.

# -- Core -------------------------------------------------------------------
ENVIRONMENT=development          # development | test | staging | production
DEBUG=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# -- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://repolens:repolens@localhost:5432/repolens

# -- Redis / background workers ---------------------------------------------
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=repolens-analysis
# When Redis is unreachable, run analyses on an in-process thread pool instead
# of failing. Convenient in development; set to false in production so a queue
# outage is visible rather than silently degraded.
ALLOW_INLINE_WORKER=true

# -- Authentication ---------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start in production while these hold their dev defaults.
JWT_SECRET=dev-insecure-jwt-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=14
# Encrypts stored GitHub tokens at rest. Rotating it invalidates stored tokens,
# and users are asked to reconnect rather than the service erroring.
ENCRYPTION_KEY=dev-insecure-encryption-key-change-me

# -- GitHub OAuth (optional) ------------------------------------------------
# Without these, public repositories can still be imported by owner/name.
# Create an OAuth app at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
# Requesting the `repo` scope is what allows private repositories to be read.
# Leave false unless private analysis is required.
GITHUB_REQUEST_PRIVATE_REPOS=false

# -- LLM (optional) ---------------------------------------------------------
# The LLM only rewrites evidence into prose and assists answer assessment.
# It can never produce or change a score. With no key, deterministic templates
# are used and the product is fully functional.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_BASE_URL=https://api.anthropic.com

# -- Vector store -----------------------------------------------------------
# Optional separate database for embeddings. Defaults to DATABASE_URL.
VECTOR_DATABASE_URL=
EMBEDDING_DIMENSIONS=256

# -- Resource limits --------------------------------------------------------
MAX_REPOSITORY_MB=256
MAX_FILES_PER_REPOSITORY=12000
MAX_FILE_KB=1024
ANALYSIS_TIMEOUT_SECONDS=900
CLONE_TIMEOUT_SECONDS=300
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_ANALYSIS_PER_HOUR=20
MAX_UPLOAD_BYTES=5242880

# -- Demo data --------------------------------------------------------------
# Seeds clearly-marked synthetic candidates. Never enable in production.
ENABLE_DEMO_SEED=false

# -- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
